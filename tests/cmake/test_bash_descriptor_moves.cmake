  check_move(1 ""
    "TIMEFORMAT=timing-marker; exec 2>failure-original 4>failure-temporary || exit; exec 10>&- 11>&- 12>&-; time ${scope} 2>&4- 12>&11- 2>&11")
  file(READ "${probe_dir}/failure-original" original)
  file(READ "${probe_dir}/failure-temporary" temporary)
  if(scope STREQUAL /bin/true)
