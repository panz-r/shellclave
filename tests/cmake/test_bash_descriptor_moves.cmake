    endif()
  elseif(NOT temporary MATCHES "timing-marker" OR original MATCHES "timing-marker")
    message(FATAL_ERROR "Timing reported through unreachable successful cleanup")
  endif()
endforeach()
# Recursive shells preserve inherited saved-FD flags as well as routes. A low
# free slot prevents Bash's temporary file open from occupying save fd 10.
foreach(direction IN ITEMS ">" "<")
  foreach(form RANGE 0 3)
    foreach(action RANGE 0 2)
      set(prefix "")
      set(fd 10)
      if(action EQUAL 1)
        set(prefix "exec 10>&-; ")
      elseif(action EQUAL 2)
        set(prefix "exec 11>&10; ")
        set(fd 11)
      endif()
      if(direction STREQUAL ">")
        set(root 1)
        set(consumer "printf CHILD")
      else()
        set(root 0)
        set(consumer "/bin/cat")
        file(WRITE "${probe_dir}/inherit-original" CHILD)
        file(WRITE "${probe_dir}/inherit-other" OTHER)
        file(WRITE "${probe_dir}/inherit-temporary" TEMP)
      endif()
      set(body "${prefix}exec ${fd}${direction}inherit-other; ${consumer} ${direction}&${fd}")
      if(form EQUAL 0)
        set(wrapper "echo \"$(${body})\"")
      elseif(form EQUAL 1)
        set(wrapper "echo \"$(echo \"$(${body})\")\"")
      elseif(form EQUAL 2)
        set(wrapper "cat < <(${body})")
      else()
        set(wrapper ": > >(${body})")
      endif()
      set(source "exec ${root}${direction}inherit-original || exit; exec 9>&- 10>&- 11>&- 12>&-; { ${wrapper}; wait; } ${root}${direction}inherit-temporary")
      if(direction STREQUAL ">")
        check_move(0 "" "${source}" "")
        file(READ "${probe_dir}/inherit-original" original)
        file(READ "${probe_dir}/inherit-other" other)
        if(action EQUAL 1)
          if(NOT original STREQUAL "" OR NOT other STREQUAL CHILD)
            message(FATAL_ERROR "Closed inherited save was incorrectly restored")
          endif()
        elseif(NOT original STREQUAL CHILD OR NOT other STREQUAL "")
          message(FATAL_ERROR "Inherited saved-FD flag was lost in ${source}")
        endif()
      else()
        if(action EQUAL 1)
          set(expected OTHER)
        else()
          set(expected CHILD)
        endif()
        if(form LESS 2)
          string(APPEND expected "\n")
        endif()
        check_move(0 "${expected}" "${source}" "")
      endif()
    endforeach()
  endforeach()
endforeach()
foreach(runner IN ITEMS true false)
  check_move(0 ""
    "exec 1>inherit-original || exit; exec 9>&- 10>&- 11>&- 12>&-; exec 10>inherit-temporary || exit; ${runner} && exec 10>&-; { echo \"$(exec 10>inherit-other || exit; printf CHILD >&10)\"; } 1>inherit-temporary" "")
  file(READ "${probe_dir}/inherit-original" original)
  file(READ "${probe_dir}/inherit-other" other)
  if(runner STREQUAL true)
    if(NOT original STREQUAL CHILD OR NOT other STREQUAL "")
      message(FATAL_ERROR "Conditional saved-FD path lost its inherited flag")
    endif()
  elseif(NOT original STREQUAL "" OR NOT other STREQUAL CHILD)
    message(FATAL_ERROR "Conditional ordinary FD acquired a saved-FD flag")
  endif()
endforeach()
