cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED SHELLCLAVE_BASH)
  message(FATAL_ERROR "Missing Bash executable")
endif()
unset(ENV{POSIXLY_CORRECT})
unset(ENV{BASH_COMPAT})
unset(ENV{BASH_XTRACEFD})
set(probe_dir "${CMAKE_CURRENT_BINARY_DIR}/descriptor-move-reference")
file(MAKE_DIRECTORY "${probe_dir}")

function(check_move expected_status expected_output source)
  execute_process(COMMAND "${SHELLCLAVE_BASH}" -p -c "${source}"
    WORKING_DIRECTORY "${probe_dir}"
    INPUT_FILE /dev/null
    OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic
    RESULT_VARIABLE status TIMEOUT 3)
  if(NOT status STREQUAL "${expected_status}" OR
     NOT output STREQUAL "${expected_output}" OR
     (ARGC GREATER 3 AND NOT diagnostic STREQUAL "${ARGV3}"))
    message(FATAL_ERROR "Descriptor move mismatch: ${source}\nstatus=${status}\noutput=${output}\n${diagnostic}")
  endif()
endfunction()

# Runtime dispatch changes the complete setup lifetime and physical allocation.
# A builtin saves stdout in 10 before allocating fd; an external child does not.
foreach(runner IN ITEMS echo /bin/echo)
  check_move(0 "payload\n"
    "runner=${runner}; exec 3>dispatch-out || exit; exec 10>&- 11>&- 12>&-; \"$runner\" payload 1>&3 {fd}>&3 1>&10; exec 3>&-; /bin/cat dispatch-out" "")
  file(READ "${probe_dir}/dispatch-out" written)
  if(runner STREQUAL /bin/echo)
    set(expected "payload\n")
  else()
    set(expected "")
  endif()
  if(NOT written STREQUAL expected)
    message(FATAL_ERROR "Dispatch ${runner} selected the wrong file route")
  endif()
endforeach()
foreach(redirect IN ITEMS "0<&0" "0<<<literal" "0<<EOF")
  set(body "")
  if(redirect STREQUAL "0<<EOF")
    set(body "\nliteral\nEOF\n")
  endif()
  check_move(0 payload
    "exec 3>&1 || exit; exec 10>&- 11>&- 12>&-; ! ${redirect} 1>&3 2>&10 && printf payload${body}")
  check_move(0 payload
    "exec 3>&1 || exit; exec 10>&- 11>&- 12>&-; ${redirect} 1>&3 2>&10 && printf impossible || printf payload${body}")
endforeach()
check_move(0 reached
  "exec 3>&1 || exit; exec 10>&- 11>&- 12>&-; 0<&0 1>&3 2>&10 >\"$(printf impossible; printf /dev/null)\"; printf reached")

check_move(0 moved "exec 3>&1; exec 4>&3-; printf moved >&4")
# Many successful redirects followed by a failed copy clean up the whole
# prefix. Exercise both repeated and distinct targets; observing save fd 10 in
# the skipped body makes these the same physical-save cases as graph tests.
foreach(count IN ITEMS 2 4 8 16)
  math(EXPR last "${count} - 1")
  foreach(distinct IN ITEMS FALSE TRUE)
    set(source "exec 3>prefix-original || exit; exec 8>&- 9>&- 10>&- 11>&-; ")
    if(distinct)
      foreach(index RANGE 0 ${last})
        math(EXPR fd "20 + ${index}")
        string(APPEND source "exec ${fd}>prefix-original || exit; ")
      endforeach()
    endif()
    string(APPEND source "{ printf impossible >&10; }")
    foreach(index RANGE 0 ${last})
      if(distinct)
        math(EXPR fd "20 + ${index}")
      else()
        set(fd 3)
      endif()
      string(APPEND source " ${fd}>prefix-${index}")
    endforeach()
    if(distinct)
      set(tail_fd 20)
    else()
      set(tail_fd 3)
    endif()
    string(APPEND source " 7>&8; printf restored >&${tail_fd}; exec ${tail_fd}>&-; /bin/cat prefix-original")
    check_move(0 restored "${source}")
  endforeach()
endforeach()
foreach(scope IN ITEMS ":" "{ :; }" "/bin/true")
  set(source "exec 1>failure-original 4>failure-temporary || exit; exec 10>&- 11>&- 12>&-; ${scope} 1>&4- 12>&11- 1>&11; printf payload")
  check_move(0 "" "${source}")
  file(READ "${probe_dir}/failure-original" original)
  file(READ "${probe_dir}/failure-temporary" temporary)
  if(scope STREQUAL /bin/true)
    if(NOT original STREQUAL payload OR NOT temporary STREQUAL "")
      message(FATAL_ERROR "Failed external setup changed its parent route")
    endif()
  elseif(NOT temporary STREQUAL payload OR NOT original STREQUAL "")
    message(FATAL_ERROR "Failed setup restored past its closed undo save")
  endif()
endforeach()
foreach(runner IN ITEMS : /bin/true)
  check_move(0 ""
    "runner=${runner}; exec 1>failure-original 4>failure-temporary || exit; exec 10>&- 11>&- 12>&-; \"$runner\" 1>&4- 12>&11- 1>&11; printf payload")
  file(READ "${probe_dir}/failure-original" original)
  file(READ "${probe_dir}/failure-temporary" temporary)
