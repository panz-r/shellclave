# These operations overlap the same physical slots. Undo and scratch disposal
# must remain interleaved in Bash's registration order, including exec's
# distinct cleanup list. Read and write spellings use the same physical rules.
foreach(direction IN ITEMS ">" "<")
  foreach(scope IN ITEMS ":" "{ :; }" /bin/true exec)
    foreach(modification IN ITEMS rebind close move)
      foreach(failure IN ITEMS "" " 5>&8")
        file(WRITE "${probe_dir}/unwind-a" payload)
        file(WRITE "${probe_dir}/unwind-b" other)
        if(modification STREQUAL rebind)
          set(tail "{fd}${direction}&4")
        elseif(modification STREQUAL close)
          set(tail "{fd}${direction}&-")
        else()
          set(tail "11${direction}&3-")
        endif()
        set(status 0)
        set(output payload)
        set(selected unwind-a)
        if(scope STREQUAL exec AND failure STREQUAL "")
          if(modification STREQUAL rebind)
            set(selected unwind-b)
            if(direction STREQUAL "<")
              set(output other)
            endif()
          else()
            set(status 1)
            set(output "")
          endif()
        endif()
        if(direction STREQUAL ">")
          set(consume "printf payload >&10 || exit 1; /bin/cat ${selected}")
        else()
          set(consume "/bin/cat <&10")
        endif()
        check_move("${status}" "${output}"
          "exec 3${direction}unwind-a 4${direction}unwind-b || exit; exec 8>&- 10>&- 11>&- 12>&- 13>&-; exec {fd}${direction}&3; ${scope} 3${direction}&\${fd}- ${tail}${failure}; ${consume}")
      endforeach()
    endforeach()
  endforeach()
endforeach()
