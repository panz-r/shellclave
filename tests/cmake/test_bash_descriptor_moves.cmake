  if(NOT padding STREQUAL "")
    message(FATAL_ERROR "Imported conditional move wrote to padding file")
  endif()
endforeach()
foreach(direction IN ITEMS ">" "<")
  if(direction STREQUAL ">")
    set(setup "exec 3>matrix-a 4>matrix-b || exit")
    set(consume "printf payload >&3 || exit 1; /bin/cat matrix-a")
    set(duplicate 1)
  else()
    set(setup "exec 3<matrix-a 4<matrix-b || exit")
    set(consume "/bin/cat <&3")
    set(duplicate 0)
  endif()
  foreach(scope IN ITEMS ":" "{ :; }" /bin/true exec)
    foreach(first IN ITEMS "-" "${duplicate}")
      foreach(operand IN ITEMS "3-" " 3-" "\"3\"-")
        foreach(failure IN ITEMS "" " 5>&8")
          file(WRITE "${probe_dir}/matrix-a" payload)
          file(WRITE "${probe_dir}/matrix-b" other)
          if(scope STREQUAL "exec" AND failure STREQUAL "")
            set(status 1)
            set(output "")
          else()
            set(status 0)
            set(output payload)
          endif()
          check_move("${status}" "${output}"
            "${setup}; exec 8>&- 10>&- 11>&- 12>&- 13>&-; ${scope} 4${direction}&${first} 10${direction}&${operand}${failure}; ${consume}")
        endforeach()
      endforeach()
    endforeach()
    foreach(modification IN ITEMS rebind close move)
      foreach(failure IN ITEMS "" " 5>&8")
        file(WRITE "${probe_dir}/matrix-a" payload)
        file(WRITE "${probe_dir}/matrix-b" other)
        set(selected matrix-a)
        set(output payload)
        set(status 0)
        if(modification STREQUAL "rebind")
          set(tail "{fd}${direction}&4")
        elseif(modification STREQUAL "close")
          set(tail "10${direction}&-")
        else()
          set(tail "10${direction}&4-")
        endif()
        if(scope STREQUAL "/bin/true" OR
           (scope STREQUAL "exec" AND modification STREQUAL "close" AND failure STREQUAL ""))
          set(status 1)
          set(output "")
        elseif(scope STREQUAL "exec" AND modification STREQUAL "move" AND failure STREQUAL "")
          set(selected matrix-b)
          if(direction STREQUAL "<")
            set(output other)
          endif()
        endif()
        if(direction STREQUAL ">")
          set(allocation_consume "printf payload >&10 || exit 1; /bin/cat ${selected}")
        else()
          set(allocation_consume "/bin/cat <&10")
        endif()
        check_move("${status}" "${output}"
          "${setup}; exec 8>&- 10>&- 11>&- 12>&- 13>&-; ${scope} {fd}${direction}&3 ${tail}${failure}; ${allocation_consume}")
