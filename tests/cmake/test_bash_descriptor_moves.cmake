foreach(direction IN ITEMS ">" "<")
  foreach(closed RANGE 10 12)
    foreach(consumer RANGE 3 5)
      if(direction STREQUAL ">")
        file(WRITE "${probe_dir}/stopped-a" "")
        file(WRITE "${probe_dir}/stopped-b" "")
        set(root 1)
        set(setup "exec 9>&1; exec 1>stopped-b 3>stopped-a 4>stopped-a 5>stopped-a || exit")
        math(EXPR target "${closed} - 7")
        if(consumer LESS_EQUAL target)
          set(selected stopped-b)
        else()
          set(selected stopped-a)
        endif()
        set(consume "printf payload >&${consumer}; /bin/cat ${selected} >&9")
        set(output payload)
      else()
        file(WRITE "${probe_dir}/stopped-a" payload)
        file(WRITE "${probe_dir}/stopped-b" other)
        set(root 0)
        set(setup "exec 0<stopped-b 3<stopped-a 4<stopped-a 5<stopped-a || exit")
        math(EXPR target "${closed} - 7")
        if(consumer LESS_EQUAL target)
          set(output other)
        else()
          set(output payload)
        endif()
        set(consume "/bin/cat <&${consumer}")
      endif()
      check_move(0 "${output}"
        "${setup}; exec 10>&- 11>&- 12>&- 13>&-; { exec ${closed}>&-; } 3${direction}&${root} 4${direction}&${root} 5${direction}&${root} && : || exit; ${consume}")
    endforeach()
  endforeach()
endforeach()
